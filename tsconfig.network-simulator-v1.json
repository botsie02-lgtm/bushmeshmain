{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["jest", "node"],
    "lib": ["ES2020", "DOM"]
  },
  "include": [
    "src/bushmesh/protocol/**/*.ts",
    "src/bushmesh/runtime/BushMeshDatagramRuntime.ts",
